# Backend configuration - set these before running terraform init
# Copy this file to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars — it is gitignored.

# ─── Backend / Remote State ───────────────────────────────────────────────────
# The KMS key must be bootstrapped (created manually or via a separate
# bootstrap module) before running `terraform init` with the S3 backend.
# Once created, copy the key ID here or export it as an environment variable:
#   export TF_VAR_tf_state_kms_key_id="<your-kms-key-id>"
tf_state_kms_key_id = "<your-kms-key-id>"

# ─── GitHub OIDC ──────────────────────────────────────────────────────────────
# These values scope the IAM trust policy so only workflows from this specific
# repository can assume the github-actions-terraform role via OIDC.
github_org  = "joekeyz8"
github_repo = "Lumigift-lumigift"

# ─── Core Infrastructure ──────────────────────────────────────────────────────
aws_region         = "us-east-1"
env                = "prod"
vpc_id             = "vpc-xxxxxxxxxxxxxxxxx"
private_subnet_ids = ["subnet-xxxxxxxxxxxxxxxxx", "subnet-yyyyyyyyyyyyyyyyy"]
db_instance_class  = "db.t4g.micro"
# db_password — set via TF_VAR_db_password environment variable, not here
redis_node_type    = "cache.t4g.micro"
app_image          = "123456789012.dkr.ecr.us-east-1.amazonaws.com/lumigift:latest"
domain_name        = "lumigift.app"

# Vercel (#335) — set VERCEL_API_TOKEN in the environment, not here
vercel_team_id       = "team_xxxxxxxxxxxxxxxxxxxxxxxx"
vercel_project_name  = "lumigift"
vercel_git_repo      = "lumigift/lumigift"
vercel_env_secret_id = "lumigift/prod/vercel-env"
vercel_env_keys      = ["DATABASE_URL", "REDIS_URL", "NEXTAUTH_SECRET", "PAYSTACK_SECRET_KEY"]
