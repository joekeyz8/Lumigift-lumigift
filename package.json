{
  "name": "lumigift",
  "version": "0.1.0",
  "private": false,
  "description": "A full-stack gifting platform on Stellar — send time-locked cash gifts that unlock on a surprise date.",
  "keywords": [
    "stellar",
    "soroban",
    "gifting",
    "blockchain",
    "usdc",
    "nextjs",
    "typescript"
  ],
  "homepage": "https://www.lumigift.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/joekeyz8/Lumigift-lumigift.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "mutation": "stryker run",
    "contract:build": "cd contracts && stellar contract build",
    "contract:test": "cd contracts && cargo test --locked",
    "contract:audit": "cd contracts && cargo audit --deny warnings",
    "contract:deploy": "ts-node scripts/deploy-contract.ts",
    "contract:smoke": "ts-node scripts/smoke-test-contract.ts",
    "contract:bindings": "npm run contract:build && ts-node scripts/generate-bindings.ts",
    "license:check": "license-checker --production --failOn 'GPL;AGPL;LGPL;GPL-2.0;GPL-3.0;AGPL-3.0;LGPL-2.0;LGPL-2.1;LGPL-3.0' --excludePrivatePackages",
    "e2e": "playwright test",
    "db:seed:test": "ts-node scripts/seed-test-db.ts",
    "db:seed:staging": "ts-node scripts/seed-staging.ts",
    "secrets:validate": "ts-node scripts/validate-production-secrets.ts",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "docker:up": "docker-compose up",
    "docker:up:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:logs": "docker-compose logs -f",
    "docker:lint": "hadolint Dockerfile",
    "docker:scan": "trivy image lumigift-app:latest",
    "docker:sbom": "syft lumigift-app:latest -o spdx-json=lumigift-sbom.spdx.json -o cyclonedx-json=lumigift-sbom.cdx.json",
    "docker:check": "bash scripts/docker-security-check.sh",
    "security:validate": "ts-node scripts/validate-security-exceptions.ts",
    "security:scan:npm": "npm audit --audit-level=critical",
    "security:scan:cargo": "cd contracts && cargo audit",
    "security:scan:terraform": "trivy config infra/terraform --severity CRITICAL,HIGH",
    "security:scan:docker": "trivy image lumigift-app:latest --severity CRITICAL",
    "security:scan": "ts-node scripts/run-all-scans.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
    "@opentelemetry/instrumentation-http": "0.57.2",
    "@opentelemetry/instrumentation-pg": "0.57.0",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-node": "0.57.2",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "@opentelemetry/semantic-conventions": "1.30.0",
    "@sentry/nextjs": "11.8.0",
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/server": "^13.1.1",
    "@stellar/stellar-sdk": "^15.1.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.13.12",
    "axios": "^1.16.1",
    "canvas": "^3.2.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.10",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "pg": "^8.20.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-hook-form": "^7.90.0",
    "redis": "^6.3.0",
    "resend": "^6.26.0",
    "stripe": "^23.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.4.0",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.11",
    "jest": "^30.4.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "license-checker": "25.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "react-dom": "^19.3.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": "prettier --write"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
